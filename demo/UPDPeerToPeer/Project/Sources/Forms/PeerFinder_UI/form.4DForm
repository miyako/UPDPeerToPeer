{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onOutsideCall",
		"onDoubleClick",
		"onDrop",
		"onMenuSelect",
		"onPluginArea",
		"onDragOver",
		"onUnload",
		"onTimer",
		"onAfterKeystroke",
		"onAfterEdit",
		"onBeginDragOver",
		"onBoundVariableChange",
		"onPageChange"
	],
	"windowTitle": ":xliff:Peer_WindowTitle",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"titleText": {
					"type": "text",
					"text": ":xliff:Peer_Title",
					"top": 50,
					"left": 50,
					"width": 1160,
					"height": 31,
					"fontTheme": "main",
					"fontSize": 24,
					"fontWeight": "bold"
				},
				"btnStartDiscovery": {
					"type": "button",
					"text": ":xliff:Peer_Announce",
					"top": 114,
					"left": 930,
					"width": 100,
					"height": 40,
					"events": [
						"onClick",
						"onMouseMove"
					],
					"style": "regular",
					"dataSource": "",
					"fontSize": 14,
					"method": "ObjectMethods/btnStartDiscovery.4dm"
				},
				"lblLocalInfoTitle": {
					"type": "text",
					"text": ":xliff:Peer_LocalInfo",
					"top": 114,
					"left": 56,
					"width": 104,
					"height": 33,
					"fontStyle": "normal",
					"textAlign": "automatic",
					"stroke": "#00003D",
					"fontSize": 14
				},
				"lstPeers": {
					"type": "listbox",
					"top": 220,
					"left": 55,
					"width": 1100,
					"height": 270,
					"resizingMode": "legacy",
					"dataSource": "Storage:C1525.discovery.peers",
					"rowHeight": "30px",
					"rowHeightAutoMin": "20px",
					"rowHeightAutoMax": "20px",
					"horizontalLineStroke": "automatic",
					"verticalLineStroke": "automatic",
					"stroke": "#000000",
					"fill": "automatic",
					"alternateFill": "automaticAlternate",
					"events": [
						"onLoad",
						"onClick",
						"onSelectionChange"
					],
					"hideExtraBlankRows": false,
					"borderStyle": "system",
					"verticalPadding": 5,
					"horizontalPadding": 5,
					"listboxType": "collection",
					"method": "ObjectMethods/lstPeers.4dm",
					"focusable": false,
					"columns": [
						{
							"name": "Column1",
							"width": 200,
							"minWidth": 10,
							"maxWidth": 32000,
							"stroke": "automatic",
							"events": [
								"onClick",
								"onDataChange",
								"onHeaderClick",
								"onFooterClick"
							],
							"header": {
								"name": "Header1",
								"text": ":xliff:Peer_ColHostname",
								"dataSource": "Header1",
								"stroke": "automatic",
								"textAlign": "automatic",
								"fontSize": 0,
								"iconPlacement": "none"
							},
							"footer": {
								"name": "Footer1",
								"timeFormat": "hh_mm_ss",
								"stroke": "#000000",
								"fill": "#FFFFFF"
							},
							"dataSource": "This:C1470.name"
						},
						{
							"name": "Column2",
							"width": 200,
							"minWidth": 10,
							"maxWidth": 32000,
							"stroke": "automatic",
							"events": [
								"onClick",
								"onDataChange",
								"onHeaderClick",
								"onFooterClick"
							],
							"header": {
								"name": "Header2",
								"text": ":xliff:Peer_ColIP",
								"dataSource": "Header2",
								"stroke": "automatic"
							},
							"footer": {
								"name": "Footer2",
								"timeFormat": "hh_mm_ss",
								"stroke": "#000000",
								"fill": "#FFFFFF"
							},
							"dataSource": "This:C1470.ip"
						},
						{
							"header": {
								"name": "Header4",
								"text": ":xliff:Peer_ColLastSeen"
							},
							"name": "Column4",
							"footer": {
								"name": "Footer4"
							},
							"width": 266,
							"dataSource": "Util_formatLastSeen(This:C1470.lastSeen)"
						},
						{
							"header": {
								"name": "Header5",
								"text": ":xliff:Peer_ColVersion"
							},
							"name": "Column5",
							"footer": {
								"name": "Footer5"
							},
							"dataSource": "This:C1470.info.version",
							"width": 100
						}
					]
				},
				"tfPeersList": {
					"type": "text",
					"text": ":xliff:Peer_Peers",
					"top": 186,
					"left": 55,
					"width": 126,
					"height": 20,
					"fontSize": 18,
					"fontWeight": "bold"
				},
				"btnRestart": {
					"type": "button",
