					"width": 111,
					"height": 35,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnRestart.4dm"
				},
				"btnStopDiscovery": {
					"type": "button",
					"text": ":xliff:Peer_Close",
					"top": 114,
					"left": 1055,
					"width": 100,
					"height": 40,
					"events": [
						"onClick",
						"onUnload"
					],
					"style": "regular",
					"dataSource": "",
					"fontSize": 14,
					"method": "ObjectMethods/btnStopDiscovery.4dm"
				},
				"Rectangle": {
					"type": "rectangle",
					"top": 510,
					"left": 56,
					"width": 833,
					"height": 276,
					"fill": "#F4F5F5",
					"borderRadius": 5,
					"stroke": "transparent"
				},
				"tfMessgeLog": {
					"type": "text",
					"text": ":xliff:Peer_Log",
					"top": 523,
					"left": 65,
					"width": 171,
					"height": 20,
					"fontSize": 18,
					"fontWeight": "bold"
				},
				"lblPeerCount": {
					"type": "text",
					"text": ":xliff:Peer_PeerCount",
					"top": 555,
					"left": 65,
					"width": 72,
					"height": 20
				},
				"Input": {
					"type": "input",
					"left": 150,
					"top": 555,
					"width": 70,
					"height": 20,
					"dataSource": "Form:C1466.peerCount",
					"enterable": false,
					"focusable": false,
					"method": "ObjectMethods/Input.4dm"
				},
				"Input1": {
					"type": "input",
					"left": 65,
					"top": 590,
					"width": 799,
					"height": 177,
					"dataSource": "Form:C1466.logText",
					"enterable": false,
					"placeholder": "",
					"multiline": "yes",
					"hideFocusRing": false,
					"borderStyle": "none",
					"borderRadius": 5,
					"scrollbarVertical": "visible",
					"focusable": false
				},
				"btnClearLog": {
					"type": "button",
					"text": ":xliff:Peer_Clear",
					"top": 519,
					"left": 779,
					"width": 85,
					"height": 29,
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/btnClearLog.4dm"
				},
				"lblHeaderLocalInfo": {
					"type": "input",
					"left": 180,
					"top": 114,
					"width": 729,
					"height": 35,
					"enterable": false,
					"fontTheme": "normal",
					"fontSize": 14,
					"method": "ObjectMethods/lblHeaderLocalInfo.4dm",
					"dataSource": "Form:C1466.lblHeaderLocalInfo",
					"events": [
						"onLoad"
					]
				}
			}
		}
	],
	"width": 1200,
	"height": 800,
	"geometryStamp": 230,
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"colorScheme": "light",
	"method": "method.4dm"
}